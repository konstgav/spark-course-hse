# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Виртуальные окружения
.venv/
venv/
env/
.conda/

# ---- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/

# ---- Spark (артефакты driver'а в текущем каталоге) --------------------------
spark-warehouse/
metastore_db/
derby.log
tmp/

# ---- Обучение моделей -------------------------------------------------------
# CatBoost пишет логи обучения в каталог запуска driver'а
catboost_info/
catboost_training.json
learn_error.tsv
test_error.tsv
time_left.tsv
snapshot.bkp

# Сохранённые модели (CatBoost, sklearn, ONNX, Spark ML, XGBoost/LightGBM)
*.cbm
*.pkl
*.pickle
*.joblib
*.onnx
*.xgb
*.lgb
*.ckpt
models/
model/

# Трекинг экспериментов и логи метрик
mlruns/
mlartifacts/
lightning_logs/
wandb/
runs/

# ---- Стенд ------------------------------------------------------------------
# Логи Airflow и сырые данные: в репозитории только пустые каталоги
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
# выборка для занятия 1 (generator/make_sample.py) хранится в git
!data/sample/

# Локальные переопределения переменных (.env с дефолтами курса хранится в git)
.env.local
docker-compose.override.yml

# ---- Слайды -----------------------------------------------------------------
# В git только исходники: slides/**/slides.md, тема и картинки в img/.
# Всё собранное (HTML, PDF, PPTX, PNG по слайдам) складывается в slides/build/
slides/build/
slides/**/*.html
slides/**/*.pdf
slides/**/*.pptx

# ---- IDE / ОС ---------------------------------------------------------------
# Настройки Marp и рекомендация расширения нужны всем, кто открывает репозиторий,
# поэтому два файла из .vscode/ хранятся в git, а личные настройки — нет.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
