# =============================================================================
# Переменные для docker-compose.yml
# =============================================================================

# ---- Версии -----------------------------------------------------------------
# ВАЖНО: на хост-машине студента должны быть ТЕ ЖЕ версии:
#   pyspark == SPARK_VERSION, Python == PYTHON_VERSION (major.minor), Java 17.
SPARK_VERSION=3.5.8
PYTHON_VERSION=3.11
AIRFLOW_VERSION=2.10.5
HADOOP_TAG=2.0.0-hadoop3.2.1-java8
# Версии jar-пакетов (Iceberg, CatBoost, JDBC) — в config/spark/spark-defaults.conf

# ---- Postgres (один инстанс: базы airflow / metastore / dwh) ----------------
POSTGRES_USER=course
POSTGRES_PASSWORD=course_pass
POSTGRES_MULTIPLE_DATABASES=airflow,metastore,dwh

# ---- Airflow ----------------------------------------------------------------
# UID, от которого работает Airflow. На Linux удобно указать свой `id -u`.
# airflow-init в любом случае выставит владельца каталога ./logs.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=YlCImzjge_TeZc7jPJ7d2WDbAgUuJ71D0GQGZBaLGuI=
AIRFLOW_SECRET_KEY=iceberg-course-webserver-secret

# ---- Ресурсы Spark-воркеров (на каждый из двух) -----------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
